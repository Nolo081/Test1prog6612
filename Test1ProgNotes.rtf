\f2\fs26 \cf0 public class TicketSales extends Tickets \{\
\
    public TicketSales(String customerName, String movieTitle, int customerAge, double moviePrice) \{\
        super(customerName, movieTitle, customerAge, moviePrice);\
    \}\
\
    @Override\
    public void print_tickets() \{\
        double discount = 0.0;\
\
        // Apply 10% discount if customer age is 65 or older\
        if (getCustomerAge() >= 65) \{\
            discount = getMoviePrice() * 0.10;\
        \}\
\
        double total = getMoviePrice() - discount;\
\
        System.out.println("\\n----------------------------------");\
        System.out.println("CUSTOMER: " + getCustomerName());\
        System.out.println("MOVIE: " + getMovieTitle());\
        System.out.println("COST: R" + getMoviePrice());\
        System.out.println("DISCOUNT: R " + discount);\
        System.out.println("TOTAL: R " + total);\
        System.out.println("----------------------------------");\
    \}\
\}\
