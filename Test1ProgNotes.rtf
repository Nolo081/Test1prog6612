\fs28 \cf0 1. Bubble Sort (Ascending Order)\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa240\partightenfactor0
\ls3\ilvl0
\fs24 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 How it works:
\f1\b0  Repeatedly steps through the list, compares adjacent elements, and swaps them if they are in the wrong order. Larger elements "bubble up" to the end of the array.\
\ls3\ilvl0
\f0\b \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Time Complexity:
\f1\b0  O(n2)\
\pard\pardeftab720\partightenfactor0
\cf0 \strokec2 Java\
\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 public class BubbleSortExample \{\
\
    public static void bubbleSort(int[] arr) \{\
        int n = arr.length;\
        \
        // Outer loop for total passes\
        for (int i = 0; i < n - 1; i++) \{\
            // Inner loop for adjacent comparisons\
            for (int j = 0; j < n - 1 - i; j++) \{\
                if (arr[j] > arr[j + 1]) \{ // Change > to < for descending order\
                    // Swap elements using a temporary variable\
                    int temp = arr[j];\
                    arr[j] = arr[j + 1];\
                    arr[j + 1] = temp;\
                \}\
            \}\
        \}\
    \}\
\
    public static void main(String[] args) \{\
        int[] data = \{64, 34, 25, 12, 22, 11, 90\};\
        bubbleSort(data);\
        \
        System.out.print("Sorted Array (Bubble Sort): ");\
        for (int num : data) \{\
            System.out.print(num + " ");\
        \}\
    \}\
\}\
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 2. Insertion Sort (Ascending Order)\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa240\partightenfactor0
\ls4\ilvl0
\fs24 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 How it works:
\f1\b0  Builds the final sorted array one item at a time. It takes an element from the unsorted portion and shifts elements in the sorted portion to insert it into its correct position.\
\ls4\ilvl0
\f0\b \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Time Complexity:
\f1\b0  O(n2) (Faster than Bubble Sort on small or partially sorted datasets).\
\pard\pardeftab720\partightenfactor0
\cf0 \strokec2 Java\
\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 public class InsertionSortExample \{\
\
    public static void insertionSort(int[] arr) \{\
        int n = arr.length;\
\
        // Start from index 1 (assume index 0 is already sorted)\
        for (int i = 1; i < n; i++) \{\
            int key = arr[i]; // Element to insert into sorted portion\
            int j = i - 1;\
\
            // Shift elements of arr[0..i-1] that are greater than key\
            // to one position ahead of their current position\
            while (j >= 0 && arr[j] > key) \{ // Change > to < for descending order\
                arr[j + 1] = arr[j];\
                j = j - 1;\
            \}\
            arr[j + 1] = key; // Place key in its correct location\
        \}\
    \}\
\
    public static void main(String[] args) \{\
        int[] data = \{12, 11, 13, 5, 6\};\
        insertionSort(data);\
\
        System.out.print("Sorted Array (Insertion Sort): ");\
        for (int num : data) \{\
            System.out.print(num + " ");\
        \}\
    \}\
\}\
\pard\pardeftab720\sa298\partightenfactor0

